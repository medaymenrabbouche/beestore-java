# ---- Étape 1 : build ----
FROM maven:3.9-eclipse-temurin-17-alpine AS builder
WORKDIR /build

# Copie uniquement le pom.xml d'abord (cache Docker pour les dépendances)
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Copie le code source et compile
COPY src ./src
RUN mvn clean package -DskipTests

# ---- Étape 2 : exécution (image finale) ----
FROM eclipse-temurin:17-jre-alpine

# Création de l'utilisateur non-root
RUN addgroup -S beestore && adduser -S beestore -G beestore
WORKDIR /app

# Utilisation d'un wildcard (*.jar) pour ne pas dépendre de la version exacte dans pom.xml
COPY --from=builder /build/target/*.jar app.jar
RUN chown beestore:beestore app.jar

USER beestore
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]